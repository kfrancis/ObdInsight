<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Core OBD-II/CAN communication for EVs: ELM327 session with recovery, shared CAN monitor with typed streams, ISO-TP/UDS, vehicle capabilities (Nissan Leaf AZE0), VIN-driven vehicle resolution, DTC reading, resilience decorators.</Description>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ObdInsight.Tests" />
    <InternalsVisibleTo Include="ObdInsight" />
    <InternalsVisibleTo Include="ObdInsight.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObdInsight.SourceGeneration\ObdInsight.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ObdInsight.Annotations\ObdInsight.Annotations.csproj" />
  </ItemGroup>

</Project>

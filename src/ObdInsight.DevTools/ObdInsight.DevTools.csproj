<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObdInsight.Core\ObdInsight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <!-- Directory.Build.props only attaches MinVer to packable projects. This app is not
         packable but its version is recorded into every capture's summary.json, so a capture
         can be traced back to the exact build that produced it. Without MinVer that stamp
         would be a constant "1.0.0" and carry no information. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Kill running instances before build to prevent file locking issues -->
  <Target Name="KillRunningInstances" BeforeTargets="Build;Rebuild;Clean">
    <Exec Command="taskkill /F /IM ObdInsight.DevTools.exe 2&gt;nul || exit 0" IgnoreExitCode="true" ContinueOnError="true" />
    <!-- Small delay to ensure process is fully terminated and file handles released -->
    <Exec Command="ping -n 2 127.0.0.1 &gt;nul" IgnoreExitCode="true" ContinueOnError="true" />
  </Target>

</Project>

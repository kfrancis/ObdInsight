<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0-windows10.0.19041.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Windows-specific properties -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0-windows10.0.19041.0'))">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObdInsight.Core\ObdInsight.Core.csproj" />
    <ProjectReference Include="..\ObdInsight.Drivers\ObdInsight.Drivers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <!-- Linux Bluetooth support (for non-Windows targets) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Linux.Bluetooth" Version="5.67.0" />
  </ItemGroup>

  <!-- Kill running instances before build to prevent file locking issues (Windows only) -->
  <Target Name="KillRunningInstances" BeforeTargets="Build;Rebuild;Clean" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="taskkill /F /IM ObdInsight.DevTools.exe 2&gt;nul || exit 0" IgnoreExitCode="true" ContinueOnError="true" />
    <!-- Small delay to ensure process is fully terminated and file handles released -->
    <Exec Command="ping -n 2 127.0.0.1 &gt;nul" IgnoreExitCode="true" ContinueOnError="true" />
  </Target>

</Project>

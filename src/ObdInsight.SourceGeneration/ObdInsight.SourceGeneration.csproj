<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <Description>Roslyn incremental generators for ObdInsight: CAN signal decoders from [CanFrame]/[CanSignal] and UDS query methods from [UdsService]/[UdsPid] definitions. Analyzer-only package — pair with ObdInsight.Annotations for the attribute types.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Attribute types + CanBits live in ObdInsight.Annotations (runtime assembly for
       consumers); compiled here as linked source so the analyzer stays self-contained
       (a ProjectReference dependency would not load in the analyzer context). -->
  <ItemGroup>
    <Compile Include="..\ObdInsight.Annotations\**\*.cs"
             Exclude="..\ObdInsight.Annotations\obj\**;..\ObdInsight.Annotations\bin\**"
             Link="Annotations\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Make this package a source generator -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer telemetry facade (roadmap B1, docs/TELEMETRY_SESSION_DESIGN.md):
    cadence-tiered polling session with normalized decimal DTOs over the Core
    capability surface. Plain net9.0, no platform or UI dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Consumer telemetry facade for ObdInsight: cadence-tiered polling session with normalized decimal DTOs (km, km/h, C, kW, V), availability reporting, snapshots, and connection-state surfacing.</Description>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObdInsight.Core\ObdInsight.Core.csproj" />
  </ItemGroup>

</Project>

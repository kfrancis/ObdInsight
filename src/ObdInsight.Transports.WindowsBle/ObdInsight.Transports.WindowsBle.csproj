<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows BLE transport built directly on WinRT (Windows.Devices.Bluetooth):
    IElmTransport plus an IBleScanner over BluetoothLEAdvertisementWatcher.
    Sibling of ObdInsight.Transports.Ble, which covers Android/iOS via Plugin.BLE;
    this one exists because WinRT GATT needs Windows-specific CCCD retry handling.
    Extracted from the console app so the app owns no transport implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Windows BLE transport for ObdInsight: IElmTransport and IBleScanner over WinRT (Windows.Devices.Bluetooth) for ELM327-family BLE OBD-II adapters.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObdInsight.Core\ObdInsight.Core.csproj" />
  </ItemGroup>

</Project>

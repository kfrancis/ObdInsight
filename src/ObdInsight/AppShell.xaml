<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ObdInsight.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ObdInsight"
    xmlns:pages="clr-namespace:ObdInsight.Pages"
    x:Name="ShellMain"
    BackgroundColor="#0D2533"
    FlyoutBehavior="Disabled"
    TabBarBackgroundColor="{StaticResource TabBarBackground}"
    TabBarForegroundColor="{StaticResource TabBarActiveItem}"
    TabBarUnselectedColor="{StaticResource TabBarInactiveItem}"
    TitleColor="#F2F3EF">

    <Shell.TitleView>
        <Grid
            Padding="0"
            BackgroundColor="Transparent"
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="8"
            HeightRequest="44"
            VerticalOptions="Center">

            <!--  App Icon  -->
            <Image
                HeightRequest="20"
                VerticalOptions="Center"
                WidthRequest="20">
                <Image.Source>
                    <FontImageSource
                        FontFamily="FontAwesome"
                        Glyph="&#xf011;"
                        Size="20"
                        Color="#63CCC0" />
                </Image.Source>
            </Image>

            <!--  Title  -->
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                Text="ObdInsight"
                TextColor="White"
                VerticalOptions="Center" />

            <!--  Connection / Busy Indicator  -->
            <Grid Grid.Column="2" Padding="15">

                <ActivityIndicator
                    HeightRequest="18"
                    HorizontalOptions="End"
                    IsRunning="False"
                    VerticalOptions="Center"
                    WidthRequest="18"
                    Color="#F2F3EF" />
            </Grid>
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="&#xf015;"
                    Color="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Devices"
            ContentTemplate="{DataTemplate pages:DevicesPage}"
            Route="devices">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="&#xf538;"
                    Color="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Diagnostics"
            ContentTemplate="{DataTemplate pages:DiagnosticReportPage}"
            Route="diagnostics">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="&#xf0f1;"
                    Color="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="settings">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="FontAwesome"
                    Glyph="&#xf013;"
                    Color="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
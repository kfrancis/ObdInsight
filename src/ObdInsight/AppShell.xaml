<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ObdInsight.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ObdInsight"
    xmlns:pages="clr-namespace:ObdInsight.Pages"
    Title="ObdInsight"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf015;" FontFamily="FontAwesome"
                               Color="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Devices"
            ContentTemplate="{DataTemplate pages:DevicesPage}"
            Route="devices">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf293;" FontFamily="FontAwesome"
                               Color="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Diagnostics"
            ContentTemplate="{DataTemplate pages:DiagnosticReportPage}"
            Route="diagnostics">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf0f3;" FontFamily="FontAwesome"
                               Color="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="settings">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf013;" FontFamily="FontAwesome"
                               Color="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
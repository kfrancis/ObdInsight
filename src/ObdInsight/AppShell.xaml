<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ObdInsight.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ObdInsight"
    xmlns:pages="clr-namespace:ObdInsight.Pages"
    Title="ObdInsight"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main" />

        <ShellContent
            Title="Devices"
            Icon="devices.png"
            ContentTemplate="{DataTemplate pages:DevicesPage}"
            Route="devices" />

        <ShellContent
            Title="Diagnostics"
            Icon="diagnostics.png"
            ContentTemplate="{DataTemplate pages:DiagnosticReportPage}"
            Route="diagnostics" />
    </TabBar>
</Shell>
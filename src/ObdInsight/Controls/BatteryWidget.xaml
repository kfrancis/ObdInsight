<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ObdInsight.Controls.BatteryWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisWidget">

    <Border
        StrokeShape="RoundRectangle 20"
        StrokeThickness="0"
        Style="{StaticResource AppWidgetCard}">
        <Grid
            Padding="16"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="8">

            <!--  Title  -->
            <Label Style="{StaticResource AppWidgetLabel}" Text="{Binding WidgetTitle, Source={x:Reference ThisWidget}}" />

            <!--  Main SOC value  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="4">
                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding SocDisplayValue, Source={x:Reference ThisWidget}}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource AppWidgetUnit}"
                    Text="%" />
            </Grid>

            <!--  SOC Progress Bar  -->
            <Grid Grid.Row="2" HeightRequest="8">
                <BoxView
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppOutlineLight},
                                                      Dark={StaticResource AppOutlineDark}}"
                    CornerRadius="4"
                    HeightRequest="8" />
                <BoxView
                    x:Name="SocProgressBar"
                    BackgroundColor="{StaticResource AppAccentLight}"
                    CornerRadius="4"
                    HeightRequest="8"
                    HorizontalOptions="Start"
                    WidthRequest="0" />
            </Grid>

            <!--  Secondary info: SOH  -->
            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,Auto"
                IsVisible="{Binding ShowSoh, Source={x:Reference ThisWidget}}">
                <Label
                    Style="{StaticResource AppTextCaption}"
                    Text="Health"
                    TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight},
                                                Dark={StaticResource AppTextMutedDark}}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource AppTextCaption}"
                    Text="{Binding SohDisplayValue, Source={x:Reference ThisWidget}}" />
            </Grid>

        </Grid>
    </Border>

</ContentView>

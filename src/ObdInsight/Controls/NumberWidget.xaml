<?xml version="1.0" encoding="utf-8" ?>
<!--
NumberWidget - Generic numeric display widget
==============================================

Usage Examples:
===============

Basic usage with title and unit:
    <controls:NumberWidget
        Title="Speed"
        Value="{Binding CurrentSpeed}"
        Unit="km/h"
        Format="F1" />

Hide unit:
    <controls:NumberWidget
        Title="RPM"
        Value="{Binding EngineRpm}"
        ShowUnit="False"
        Format="F0" />

With FontAwesome icon:
    <controls:NumberWidget
        Title="Range"
        Value="{Binding VehicleDataStore.RangeRemaining}"
        Unit="km"
        ShowIcon="True"
        Icon="&#xf4d7;"
        Format="F0" />

Custom placeholder for null values:
    <controls:NumberWidget
        Title="Temperature"
        Value="{Binding CurrentTemp}"
        Unit="°C"
        Placeholder="N/A"
        Format="F1" />

Properties:
===========
* Value (double?): The numeric value to display (bindable)
* Title (string): Widget title/label
* Unit (string): Unit text (e.g., "km", "kW", "%")
* ShowUnit (bool): Show/hide unit (default: true)
* Icon (string): FontAwesome icon character (e.g., "&#xf4d7;")
* ShowIcon (bool): Show/hide icon (default: false)
* Format (string): Number format string (default: "F0")
                   Examples: "F0" = 123, "F1" = 123.4, "F2" = 123.45, "N2" = 1,234.56
* Placeholder (string): Text shown when Value is null (default: two dashes)-->
<ContentView
    x:Class="ObdInsight.Controls.NumberWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisWidget">

    <Border
        StrokeShape="RoundRectangle 20"
        StrokeThickness="0"
        Style="{StaticResource AppWidgetCard}">
        <Grid
            Padding="16"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">

            <!--  Icon (optional)  -->
            <Label
                Padding="10,0,0,0"
                FontFamily="FontAwesome"
                FontSize="24"
                IsVisible="{Binding ShowIcon, Source={x:Reference ThisWidget}}"
                Text="{Binding Icon, Source={x:Reference ThisWidget}}"
                TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}"
                VerticalOptions="Center" />

            <!--  Main value  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="4">
                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding DisplayValue, Source={x:Reference ThisWidget}}" />
                <Label
                    Grid.Column="1"
                    IsVisible="{Binding ShowUnit, Source={x:Reference ThisWidget}}"
                    Style="{StaticResource AppWidgetUnit}"
                    Text="{Binding Unit, Source={x:Reference ThisWidget}}" />
            </Grid>

            <!--  Title  -->
            <Label
                Grid.Row="2"
                Text="{Binding Title, Source={x:Reference ThisWidget}}"
                TextColor="White" />
        </Grid>
    </Border>

</ContentView>

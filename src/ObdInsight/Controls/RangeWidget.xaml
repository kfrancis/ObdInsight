<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ObdInsight.Controls.RangeWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisWidget">

    <Border
        Background="{StaticResource AppCardGradientBrush}"
        StrokeShape="RoundRectangle 16"
        Style="{StaticResource AppWidgetCard}">
        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            
            <!--  Title  -->
            <Label 
                Style="{StaticResource AppWidgetLabel}" 
                Text="{Binding WidgetTitle, Source={x:Reference ThisWidget}}" />

            <!--  Main range value  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="4">
                <Label
                    Style="{StaticResource AppWidgetValue}"
                    Text="{Binding RangeDisplayValue, Source={x:Reference ThisWidget}}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource AppWidgetUnit}"
                    Text="{Binding UnitDisplay, Source={x:Reference ThisWidget}}" />
            </Grid>

            <!--  Efficiency or secondary info  -->
            <Label
                Grid.Row="2"
                IsVisible="{Binding ShowEfficiency, Source={x:Reference ThisWidget}}"
                Style="{StaticResource AppTextCaption}"
                Text="{Binding EfficiencyText, Source={x:Reference ThisWidget}}"
                TextColor="{AppThemeBinding Light={StaticResource AppTextMutedLight}, Dark={StaticResource AppTextMutedDark}}" />
            
        </Grid>
    </Border>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ObdInsight.Controls.RangeWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ThisWidget">

    <Border
        StrokeShape="RoundRectangle 20"
        StrokeThickness="0"
        Style="{StaticResource AppWidgetCard}">
        <Grid
            Padding="16"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">

            <Label
                Padding="10,0,0,0"
                FontFamily="FontAwesome"
                FontSize="24"
                Text="&#xf4d7;"
                TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                            Dark={StaticResource AppAccentDark}}"
                VerticalOptions="Center" />

            <!--  Main range value  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,Auto"
                ColumnSpacing="4">
                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding RangeDisplayValue, Source={x:Reference ThisWidget}}" />
                <Label
                    Grid.Column="1"
                    Style="{StaticResource AppWidgetUnit}"
                    Text="{Binding UnitDisplay, Source={x:Reference ThisWidget}}" />
            </Grid>

            <!--  Title  -->
            <Label
                Grid.Row="2"
                Text="{Binding WidgetTitle, Source={x:Reference ThisWidget}}"
                TextColor="White" />
        </Grid>
    </Border>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ObdInsight.ViewModels"
             x:Class="ObdInsight.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Connection Status Card -->
            <Border
                Stroke="{StaticResource Primary}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                Padding="15"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Connection Status"
                        FontAttributes="Bold"
                        FontSize="18" />
                    <Label
                        Text="{Binding ConnectionStatus}"
                        FontSize="16"
                        TextColor="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />
                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsConnected}">
                        <Label Text="Adapter:" FontAttributes="Bold" />
                        <Label Text="{Binding AdapterName}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsConnected}">
                        <Label Text="Vehicle:" FontAttributes="Bold" />
                        <Label Text="{Binding VehicleName}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Button
                Text="Scan for Devices"
                Command="{Binding ScanForDevicesCommand}"
                IsVisible="{Binding IsNotBusy}"
                HorizontalOptions="Fill" />

            <HorizontalStackLayout
                Spacing="10"
                HorizontalOptions="Center"
                IsVisible="{Binding IsConnected}">
                <Button
                    Text="Refresh"
                    Command="{Binding RefreshDataCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Text="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    BackgroundColor="{StaticResource Gray500}"
                    IsEnabled="{Binding IsNotBusy}" />
            </HorizontalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{StaticResource Primary}" />

            <!-- Error Display -->
            <Border
                IsVisible="{Binding HasError}"
                Stroke="Red"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 5"
                Padding="10"
                BackgroundColor="#FFEEEE">
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="Red" />
            </Border>

            <!-- Vehicle Data (shown when connected) -->
            <Border
                IsVisible="{Binding IsConnected}"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="15"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <VerticalStackLayout Spacing="15">
                    <Label
                        Text="Vehicle Data"
                        FontAttributes="Bold"
                        FontSize="18" />

                    <!-- Battery SOC -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BatterySoc, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="Battery SOC" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding BatterySoc, StringFormat='{0:F1}%'}"
                            FontAttributes="Bold"
                            FontSize="20" />
                    </Grid>

                    <!-- Battery Voltage -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BatteryVoltage, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="Battery Voltage" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding BatteryVoltage, StringFormat='{0:F1} V'}"
                            FontAttributes="Bold"
                            FontSize="20" />
                    </Grid>

                    <!-- Range Remaining -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding RangeRemaining, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="Range Remaining" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding RangeRemaining, StringFormat='{0:F0} mi'}"
                            FontAttributes="Bold"
                            FontSize="20" />
                    </Grid>

                    <!-- Charging Status -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ChargingStatus, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="Charging Status" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding ChargingStatus}"
                            FontAttributes="Bold"
                            FontSize="16" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Welcome message when not connected -->
            <VerticalStackLayout
                IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}"
                Spacing="15"
                Padding="20">
                <Image
                    Source="dotnet_bot.png"
                    HeightRequest="150"
                    Aspect="AspectFit" />
                <Label
                    Text="Welcome to OBD Insight"
                    Style="{StaticResource Headline}"
                    HorizontalOptions="Center" />
                <Label
                    Text="Connect to your OBD adapter to view vehicle diagnostics and data."
                    HorizontalTextAlignment="Center"
                    FontSize="16" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
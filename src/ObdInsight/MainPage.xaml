<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ObdInsight.Controls"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    x:DataType="vm:MainViewModel">

    <ScrollView x:Name="MainScrollView" Scrolled="OnScrolled">
        <VerticalStackLayout>

            <!--  Hero Section with Teal Gradient  -->
            <Grid x:Name="HeroSection" HeightRequest="400">
                <Border StrokeThickness="0">
                    <Grid>
                        <!--  Large vehicle image, centered  -->
                        <Image
                            x:Name="VehicleImage"
                            Margin="40,60,40,40"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Source="car.png"
                            VerticalOptions="Center" />

                        <!--  Vehicle info overlay at bottom  -->
                        <Grid
                            x:Name="VehicleInfoOverlay"
                            Padding="20,10"
                            RowDefinitions="Auto,Auto,Auto"
                            VerticalOptions="End">

                            <Label
                                x:Name="VehicleNameLabel"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                Style="{StaticResource AppTextHero}"
                                Text="{Binding ActiveVehicleName}" />

                            <Label
                                x:Name="VehicleSubtitleLabel"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                Style="{StaticResource AppTextCaption}"
                                Text="{Binding ActiveVehicleSubtitle}" />

                            <!--  Connection status + Devices button  -->
                            <Grid
                                x:Name="ConnectionStatusGrid"
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                ColumnDefinitions="*,Auto">
                                <Label
                                    Style="{StaticResource AppTextCaption}"
                                    Text="{Binding ConnectionStatus}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="1"
                                    Padding="16,8"
                                    Command="{Binding ScanForDevicesCommand}"
                                    FontSize="{StaticResource AppFontSizeCaption}"
                                    Text="Devices" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--  Content: widget cards grid  -->
            <VerticalStackLayout Padding="{StaticResource AppPagePadding}" Spacing="{StaticResource AppSpacingMd}">

                <!--  Primary widgets grid  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="{StaticResource AppSpacingMd}"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource AppSpacingMd}">

                    <controls:NumberWidget
                        Title="Range"
                        Format="F0"
                        Icon="&#xf4d7;"
                        ShowIcon="True"
                        Unit="km"
                        Value="{Binding VehicleDataStore.RangeRemaining}" />

                    <!--  Battery Widget (new)  -->
                    <controls:BatteryWidget
                        Grid.Column="1"
                        AutoHideWhenUnavailable="False"
                        DataStore="{Binding VehicleDataStore}" />

                    <!--  Charging Widget (new)  -->
                    <controls:ChargingWidget
                        Grid.Row="1"
                        AutoHideWhenUnavailable="False"
                        DataStore="{Binding VehicleDataStore}" />

                    <!--  Example: NumberWidget showing Range using direct binding  -->


                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
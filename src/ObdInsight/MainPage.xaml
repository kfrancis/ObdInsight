<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:MainViewModel"
    BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="6*,4*">

        <!--  Hero Section with Teal Gradient  -->
        <Grid Grid.Row="0">
            <Border Background="{StaticResource AppHeroGradientBrush}" StrokeThickness="0">
                <Grid>
                    <!--  Large vehicle image, centered  -->
                    <Image
                        Margin="40,60,40,40"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        Source="{Binding ActiveVehicleImage}"
                        VerticalOptions="Center" />

                    <!--  Vehicle info overlay at bottom  -->
                    <Grid
                        Padding="20,20,20,30"
                        RowDefinitions="Auto,Auto,Auto"
                        VerticalOptions="End">

                        <!--  Semi-transparent overlay for text readability  -->
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.0" Color="#00000000" />
                                <GradientStop Offset="1.0" Color="#80000000" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Label
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            Style="{StaticResource AppTextHero}"
                            Text="{Binding ActiveVehicleName}" />

                        <Label
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            Style="{StaticResource AppTextCaption}"
                            Text="{Binding ActiveVehicleSubtitle}" />

                        <!--  Connection status + Devices button  -->
                        <Grid
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            ColumnDefinitions="*,Auto">
                            <Label
                                Style="{StaticResource AppTextCaption}"
                                Text="{Binding ConnectionStatus}"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Padding="16,8"
                                Command="{Binding ScanForDevicesCommand}"
                                FontSize="{StaticResource AppFontSizeCaption}"
                                Text="Devices" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Content: widget cards grid  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource AppPagePadding}" Spacing="{StaticResource AppSpacingMd}">

                <!--  Primary widgets grid  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="{StaticResource AppSpacingMd}"
                    RowSpacing="{StaticResource AppSpacingMd}">

                    <!--  Range (always shown)  -->
                    <Border
                        Background="{StaticResource AppCardGradientBrush}"
                        StrokeShape="RoundRectangle 16"
                        Style="{StaticResource AppWidgetCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Style="{StaticResource AppWidgetLabel}" Text="Range" />
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="0">
                                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding RangeDisplay}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource AppWidgetUnit}"
                                    Text="{Binding RangeUnit}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Battery Percent (BEV/Hybrid typically)  -->
                    <Border
                        Background="{StaticResource AppCardGradientBrush}"
                        StrokeShape="RoundRectangle 16"
                        Style="{StaticResource AppWidgetCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Style="{StaticResource AppWidgetLabel}" Text="Battery" />
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="0">
                                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding BatteryPercentDisplay}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource AppWidgetUnit}"
                                    Text="%" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Charging (optional)  -->
                    <Border
                        Background="{StaticResource AppCardGradientBrush}"
                        StrokeShape="RoundRectangle 16"
                        Style="{StaticResource AppWidgetCard}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Label Style="{StaticResource AppWidgetLabel}" Text="Charging" />
                            <Label
                                Grid.Row="1"
                                LineBreakMode="TailTruncation"
                                Style="{StaticResource AppTextTitle}"
                                Text="{Binding ChargingStatusDisplay}" />
                        </Grid>
                    </Border>

                    <!--  Secondary metric (placeholder)  -->
                    <Border
                        Background="{StaticResource AppCardGradientBrush}"
                        StrokeShape="RoundRectangle 16"
                        Style="{StaticResource AppWidgetCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Style="{StaticResource AppWidgetLabel}" Text="Metric" />
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="0">
                                <Label Style="{StaticResource AppWidgetValue}" Text="{Binding SecondaryMetricValueDisplay}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource AppWidgetUnit}"
                                    Text="{Binding SecondaryMetricUnit}" />
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
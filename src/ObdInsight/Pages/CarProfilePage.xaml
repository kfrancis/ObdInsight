<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.Pages.CarProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:CarProfileViewModel">

    <Grid Padding="0" RowDefinitions="Auto,*,Auto">

        <!--  Header with Edit Button  -->
        <Grid
            Grid.Row="0"
            Padding="20,20,20,10"
            ColumnDefinitions="*,Auto">
            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="Car Profile"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Padding="15,8"
                Command="{Binding EditVehicleCommand}"
                FontSize="14"
                Text="Edit"
                VerticalOptions="Center" />
        </Grid>

        <!--  Main Content  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="25">
                <!--  Vehicle Name Input  -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontSize="14"
                        Text="Vehicle Name"
                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                    <Border
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                                          Dark={StaticResource AppSurfaceRaisedDark}}"
                        Stroke="{StaticResource Gray300}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Entry
                            FontSize="16"
                            Placeholder="Enter a name for your vehicle"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                Dark={StaticResource AppTextSecondaryDark}}"
                            Text="{Binding VehicleName}"
                            TextColor="{AppThemeBinding Light={StaticResource AppTextPrimaryLight},
                                                        Dark={StaticResource AppTextPrimaryDark}}" />
                    </Border>
                </VerticalStackLayout>

                <Label
                    Margin="0,10,0,10"
                    FontSize="14"
                    Text="Select which widgets to display on the main screen."
                    TextColor="#78E6D8" />

                <!--  Main Screen Preview  -->
                <Border
                    Padding="20"
                    BackgroundColor="#E00A212C"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="Main Screen Preview" />
                        <Image
                            Margin="0,10"
                            Aspect="AspectFit"
                            HeightRequest="120"
                            Source="car.png" />

                        <!--  2x2 Grid of Stats  -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">
                            <!--  Range Card  -->
                            <Border
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                                                  Dark={StaticResource AppSurfaceRaisedDark}}"
                                IsVisible="{Binding ShowRange}"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="20"
                                        HorizontalOptions="Start"
                                        Text="&#xf0e7;" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding RangeValue}" />
                                    <Label
                                        FontSize="11"
                                        Text="Range"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <!--  Battery Card  -->
                            <Border
                                Grid.Column="1"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                                                  Dark={StaticResource AppSurfaceRaisedDark}}"
                                IsVisible="{Binding ShowBattery}"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="20"
                                        HorizontalOptions="Start"
                                        Text="&#xf240;" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding BatteryValue}" />
                                    <Label
                                        FontSize="11"
                                        Text="Battery"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <!--  Efficiency Card  -->
                            <Border
                                Grid.Row="1"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                                                  Dark={StaticResource AppSurfaceRaisedDark}}"
                                IsVisible="{Binding ShowEfficiency}"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="20"
                                        HorizontalOptions="Start"
                                        Text="&#xf201;" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding EfficiencyValue}" />
                                    <Label
                                        FontSize="11"
                                        Text="Efficiency"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <!--  Charging Card  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                                                  Dark={StaticResource AppSurfaceRaisedDark}}"
                                IsVisible="{Binding ShowCharging}"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="20"
                                        HorizontalOptions="Start"
                                        Text="&#xf1e6;" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding ChargingValue}" />
                                    <Label
                                        FontSize="11"
                                        Text="Charging"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Widget Toggles List  -->
                <VerticalStackLayout Spacing="15">
                    <!--  Range Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf0e7;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Range" />
                            <Label
                                FontSize="12"
                                Text="Battery remaining"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowRange}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                    <!--  Battery Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf240;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Battery" />
                            <Label
                                FontSize="12"
                                Text="Current battery level"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowBattery}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                    <!--  Efficiency Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf201;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Efficiency" />
                            <Label
                                FontSize="12"
                                Text="Miles per kWh/100 km"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowEfficiency}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                    <!--  Charging Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf1e6;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Charging" />
                            <Label
                                FontSize="12"
                                Text="Charging power &amp; time left"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowCharging}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                    <!--  Tire Pressure Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf1de;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Tire Pressure" />
                            <Label
                                FontSize="12"
                                Text="Pressure level of all tires"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowTirePressure}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                    <!--  Motor Power Toggle  -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Label
                            FontFamily="FontAwesome"
                            FontSize="28"
                            Text="&#xf013;"
                            TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                        Dark={StaticResource AppAccentDark}}"
                            VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Motor Power" />
                            <Label
                                FontSize="12"
                                Text="Motor power in real-time"
                                TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                            Dark={StaticResource AppTextSecondaryDark}}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            IsToggled="{Binding ShowMotorPower}"
                            OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                      Dark={StaticResource AppAccentDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Footer: Save Button  -->
        <Button
            Grid.Row="2"
            Margin="20"
            Command="{Binding SaveProfileCommand}"
            FontAttributes="Bold"
            HeightRequest="50"
            Text="Save Profile" />
    </Grid>
</ContentPage>

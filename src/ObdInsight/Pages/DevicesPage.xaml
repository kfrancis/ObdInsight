<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ObdInsight.ViewModels"
             x:Class="ObdInsight.Pages.DevicesPage"
             x:DataType="vm:DevicesViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Hero Section with OBD Adapter Image -->
        <Grid Grid.Row="0" HeightRequest="320">
            <Border StrokeThickness="0" Background="{StaticResource AppHeroGradientBrush}">
                <Grid Padding="20,40,20,20">
                    <!-- Large centered OBD adapter image -->
                    <Image Source="obd_adapter.png" Aspect="AspectFit"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           HeightRequest="180" Margin="40,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Device Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="OBD2 Adapter" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Connect a wireless OBD2 adapter to access car diagnostics."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}"
                           HorizontalTextAlignment="Center" Margin="20,0" />

                    <!-- Connect Button -->
                    <Button Text="Connect" Command="{Binding StartScanCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}"
                            CornerRadius="8" HeightRequest="50" Margin="40,10" />
                </VerticalStackLayout>

                <!-- Compatibility Section -->
                <Border Stroke="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBackgroundLight}, Dark={StaticResource AppCardBackgroundDark}}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Compatibility" FontSize="16" FontAttributes="Bold" />
                        <Label Text="This app supports all standard OBD2 adapters." FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight}, Dark={StaticResource AppTextSecondaryDark}}" />

                        <!-- Bluetooth Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label Text="&#xf294;" FontFamily="FontAwesome" FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Bluetooth (BLE)" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Switch Grid.Column="2" IsToggled="{Binding BluetoothEnabled}"
                                    OnColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                        <!-- Wi-Fi Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label Text="&#xf1eb;" FontFamily="FontAwesome" FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Wi-Fi" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Switch Grid.Column="2" IsToggled="{Binding WiFiEnabled}"
                                    OnColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Scanning State - Collapsible Device List -->
                <Border IsVisible="{Binding IsScanning}"
                        Stroke="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBackgroundLight}, Dark={StaticResource AppCardBackgroundDark}}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" HeightRequest="20" WidthRequest="20" />
                            <Label Text="Scanning for devices..." FontAttributes="Bold" />
                        </HorizontalStackLayout>

                        <!-- Device List -->
                        <CollectionView ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDevice}"
                                      SelectionMode="Single" HeightRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceListItem">
                                    <Border Margin="0,5" Padding="10" StrokeThickness="1" Stroke="{Binding BorderColor}"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceLight}, Dark={StaticResource AppSurfaceDark}}">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label Text="{Binding Device.Name}" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="{Binding Device.Rssi, StringFormat='{0} dBm'}"
                                                   TextColor="{StaticResource Gray500}" FontSize="12" />
                                            <Label Grid.Row="1" Text="{Binding Device.Address}"
                                                   TextColor="{StaticResource Gray500}" FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="Stop Scan" Command="{Binding StopScanCommand}" BackgroundColor="{StaticResource Gray500}" />
                            <Button Text="Connect" Command="{Binding ConnectToDeviceCommand}"
                                    IsEnabled="{Binding SelectedDevice, Converter={StaticResource NullToBoolConverter}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Learn More Link -->
                <Label Text="Looking for a compatible adapter? Learn more" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource AppAccentLight}, Dark={StaticResource AppAccentDark}}"
                       HorizontalTextAlignment="Center" Margin="0,10">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LearnMoreCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Error Display -->
        <Border Grid.Row="2" IsVisible="{Binding HasError}"
                Stroke="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}"
                StrokeThickness="1" StrokeShape="RoundRectangle 5" Padding="10" Margin="15"
                BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight}, Dark={StaticResource AppSurfaceRaisedDark}}">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}" />
        </Border>
    </Grid>
</ContentPage>
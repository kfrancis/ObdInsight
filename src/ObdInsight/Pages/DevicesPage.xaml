<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ObdInsight.ViewModels"
             x:Class="ObdInsight.Pages.DevicesPage"
             x:DataType="vm:DevicesViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="15">

        <!-- Header with scan controls -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label
                Text="Scan for nearby BLE devices"
                FontSize="16"
                HorizontalOptions="Center" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button
                    Text="Start Scan"
                    Command="{Binding StartScanCommand}"
                    IsVisible="{Binding IsScanning, Converter={StaticResource InvertedBoolConverter}}" />
                <Button
                    Text="Stop Scan"
                    Command="{Binding StopScanCommand}"
                    IsVisible="{Binding IsScanning}"
                    BackgroundColor="{StaticResource Gray500}" />
            </HorizontalStackLayout>

            <!-- Status text -->
            <Label
                Text="{Binding ScanStatus}"
                FontSize="12"
                TextColor="{StaticResource Gray500}"
                HorizontalOptions="Center"
                IsVisible="{Binding ScanStatus, Converter={StaticResource NullToBoolConverter}}" />

            <!-- Scanning indicator -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10"
                IsVisible="{Binding IsScanning}">
                <ActivityIndicator
                    IsRunning="True"
                    Color="{StaticResource Primary}"
                    HeightRequest="20"
                    WidthRequest="20" />
                <Label Text="Scanning..." />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Device list -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding DiscoveredDevices}"
            SelectedItem="{Binding SelectedDevice}"
            SelectionMode="Single"
            Margin="0,15">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10">
                    <Label
                        Text="No devices found"
                        FontSize="18"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Tap 'Start Scan' to search for BLE devices"
                        FontSize="14"
                        TextColor="{StaticResource Gray400}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Likely OBD adapters will be highlighted in green"
                        FontSize="12"
                        TextColor="{StaticResource Gray400}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceListItem">
                    <Border
                        Margin="5"
                        Padding="15"
                        StrokeThickness="{Binding IsLikelyObdAdapter, Converter={StaticResource BoolToStrokeThicknessConverter}}"
                        Stroke="{Binding BorderColor}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding Device.Name}"
                                    FontAttributes="Bold"
                                    FontSize="16" />
                                <!-- OBD Badge for likely adapters -->
                                <Border
                                    IsVisible="{Binding IsLikelyObdAdapter}"
                                    BackgroundColor="Green"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="6,2">
                                    <Label
                                        Text="OBD"
                                        TextColor="White"
                                        FontSize="10"
                                        FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label
                                Grid.Column="1"
                                Text="{Binding Device.Rssi, StringFormat='{0} dBm'}"
                                TextColor="{StaticResource Gray500}"
                                FontSize="12"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding Device.Address}"
                                TextColor="{StaticResource Gray500}"
                                FontSize="12" />
                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Spacing="5"
                                Margin="0,5,0,0">
                                <Label
                                    Text="Services:"
                                    FontSize="11"
                                    TextColor="{StaticResource Gray400}" />
                                <Label
                                    Text="{Binding Device.AdvertisedServices.Count}"
                                    FontSize="11"
                                    TextColor="{StaticResource Gray400}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer with connect button -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <!-- Error Display -->
            <Border
                IsVisible="{Binding HasError}"
                Stroke="Red"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 5"
                Padding="10"
                BackgroundColor="#FFEEEE">
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="Red" />
            </Border>

            <!-- Loading indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{StaticResource Primary}" />

            <Button
                Text="Connect"
                Command="{Binding ConnectToDeviceCommand}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <!-- Debug Log Panel - Shows connection debugging info -->
        <Border 
            x:Name="DebugPanel"
            Grid.Row="3" 
            Stroke="{StaticResource Gray400}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 5"
            Padding="8"
            Margin="0,10,0,0"
            HeightRequest="150"
            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}">
            <ScrollView x:Name="DebugScrollView">
                <Label 
                    x:Name="DebugLogLabel"
                    Text="{Binding DebugLog}"
                    FontSize="10"
                    TextColor="{StaticResource Gray600}"
                    LineBreakMode="WordWrap" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
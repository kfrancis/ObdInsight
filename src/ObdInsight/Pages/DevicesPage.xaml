<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:DevicesViewModel"
    BackgroundColor="{StaticResource Background}">

    <Grid Padding="0" RowDefinitions="Auto,*,Auto">
        <!--  Base gradient  -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#172A3A" />
                    <GradientStop Offset="0.55" Color="#004346" />
                    <GradientStop Offset="1.0" Color="#172A3A" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  Subtle highlight wash  -->
        <BoxView Opacity="0.35">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                    <GradientStop Offset="0.0" Color="#75DDDD" />
                    <GradientStop Offset="0.6" Color="Transparent" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  Hero Section with OBD Adapter Image  -->
        <Grid Grid.Row="0">
            <Border StrokeThickness="0">
                <!--<Border.StrokeShape>
                -->
                <!--  Only TopLeft corner rounded  -->
                <!--
                    <RoundRectangle CornerRadius="0,0,20,20" Clip="" />
                </Border.StrokeShape>-->
                <Grid>
                    <!--  Large centered OBD adapter image  -->
                    <Image
                        Margin="40,0"
                        Aspect="AspectFit"
                        HeightRequest="180"
                        HorizontalOptions="Center"
                        Source="obd_adapter.png"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!--  Main Content  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!--  Device Section  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBackgroundLight},
                                                      Dark={StaticResource AppCardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource AppOutlineLight},
                                             Dark={StaticResource AppOutlineDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="20" Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            Text="OBD2 Adapter" />
                        <Label
                            Margin="20,0"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="Connect a wireless OBD2 adapter to access car diagnostics."
                            TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                        Dark={StaticResource AppTextSecondaryDark}}" />

                        <!--  Connect Button  -->
                        <Button
                            Margin="40,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                              Dark={StaticResource AppAccentDark}}"
                            Command="{Binding StartScanCommand}"
                            CornerRadius="8"
                            HeightRequest="50"
                            Text="Connect" />
                    </VerticalStackLayout>
                </Border>

                <!--  Compatibility Section  -->
                <Border
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBackgroundLight},
                                                      Dark={StaticResource AppCardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource AppOutlineLight},
                                             Dark={StaticResource AppOutlineDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Compatibility" />
                        <Label
                            FontSize="12"
                            Text="This app supports all standard OBD2 adapters."
                            TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                        Dark={StaticResource AppTextSecondaryDark}}" />

                        <!--  Bluetooth Toggle  -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label
                                FontFamily="FontAwesomeBrands"
                                FontSize="24"
                                Text="&#xf293;"
                                TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                            Dark={StaticResource AppAccentDark}}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Bluetooth (BLE)"
                                VerticalOptions="Center" />
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding BluetoothEnabled}"
                                OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                          Dark={StaticResource AppAccentDark}}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                        <!--  Wi-Fi Toggle  -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label
                                FontFamily="FontAwesome"
                                FontSize="24"
                                Text="&#xf1eb;"
                                TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                            Dark={StaticResource AppAccentDark}}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Wi-Fi"
                                VerticalOptions="Center" />
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding WiFiEnabled}"
                                OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                          Dark={StaticResource AppAccentDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Scanning State - Collapsible Device List  -->
                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AppCardBackgroundLight},
                                                      Dark={StaticResource AppCardBackgroundDark}}"
                    IsVisible="{Binding IsScanning}"
                    Stroke="{AppThemeBinding Light={StaticResource AppOutlineLight},
                                             Dark={StaticResource AppOutlineDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <ActivityIndicator
                                HeightRequest="20"
                                IsRunning="True"
                                WidthRequest="20"
                                Color="#F2F3EF" />
                            <Label FontAttributes="Bold" Text="Scanning for devices..." />
                        </HorizontalStackLayout>

                        <!--  Device List  -->
                        <CollectionView
                            HeightRequest="200"
                            ItemsSource="{Binding DiscoveredDevices}"
                            SelectedItem="{Binding SelectedDevice}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceListItem">
                                    <Border
                                        Margin="0,5"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceLight},
                                                                          Dark={StaticResource AppSurfaceDark}}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <Label FontAttributes="Bold" Text="{Binding Device.Name}" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Device.Rssi, StringFormat='{0} dBm'}"
                                                TextColor="{StaticResource Gray500}" />
                                            <Label
                                                Grid.Row="1"
                                                FontSize="12"
                                                Text="{Binding Device.Address}"
                                                TextColor="{StaticResource Gray500}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Button
                                BackgroundColor="{StaticResource Gray500}"
                                Command="{Binding StopScanCommand}"
                                Text="Stop Scan" />
                            <Button
                                Command="{Binding ConnectToDeviceCommand}"
                                IsEnabled="{Binding SelectedDevice, Converter={StaticResource NullToBoolConverter}}"
                                Text="Connect" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Learn More Link  -->
                <Label
                    Margin="0,10"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Looking for a compatible adapter? Learn more"
                    TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                Dark={StaticResource AppAccentDark}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LearnMoreCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Error Display  -->
        <Border
            Grid.Row="2"
            Margin="15"
            Padding="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                              Dark={StaticResource AppSurfaceRaisedDark}}"
            IsVisible="{Binding HasError}"
            Stroke="{AppThemeBinding Light={StaticResource AppDangerLight},
                                     Dark={StaticResource AppDangerDark}}"
            StrokeShape="RoundRectangle 5"
            StrokeThickness="1">
            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}" />
        </Border>
    </Grid>
</ContentPage>
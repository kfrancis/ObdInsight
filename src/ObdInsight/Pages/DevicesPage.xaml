<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:DevicesViewModel">

    <Grid Padding="0" RowDefinitions="Auto,*,Auto">

        <!--  Hero Section with OBD Adapter Image  -->
        <Grid Grid.Row="0">
            <Border StrokeThickness="0">
                <Grid>
                    <!--  Large centered OBD adapter image  -->
                    <Image
                        Margin="40,0"
                        Aspect="AspectFit"
                        HeightRequest="180"
                        HorizontalOptions="Center"
                        Source="obd_adapter.png"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!--  Main Content  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="20">

                <!--  Device Section  -->
                <Border
                    BackgroundColor="#E00A212C"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <VerticalStackLayout Padding="20">
                        <Label
                            FontAttributes="Bold"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            Text="OBD2 Adapter"
                            TextColor="#FDFEFE" />

                        <Label
                            Margin="20,0"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding NotShowingDeviceList}"
                            Text="Connect a wireless OBD2 adapter to access car diagnostics."
                            TextColor="#9DC3CC" />

                        <!--  Remember / Auto-connect  -->
                        <Border
                            Margin="0,10,0,0"
                            Padding="12"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0">
                            <VerticalStackLayout Padding="5,0" Spacing="8">
                                <Grid ColumnDefinitions="*,50" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Padding="0,10,0,0"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Auto-connect" />
                                    <Switch
                                        Grid.Column="1"
                                        IsToggled="{Binding AutoConnectToLastAdapter}"
                                        OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                  Dark={StaticResource AppAccentDark}}" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding HasLastAdapter}">
                                    <Label
                                        Grid.Column="0"
                                        Padding="0,15,0,0"
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding LastAdapterDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource AppTextSecondaryLight},
                                                                    Dark={StaticResource AppTextSecondaryDark}}" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="10,6"
                                        BackgroundColor="{StaticResource Gray500}"
                                        Command="{Binding ClearLastAdapterCommand}"
                                        FontSize="12"
                                        Text="Forget" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!--  Connect Button  -->
                        <Button
                            Margin="40,10"
                            BackgroundColor="#75DDDD"
                            Command="{Binding StartScanCommand}"
                            CornerRadius="12"
                            HeightRequest="50"
                            IsVisible="{Binding NotShowingDeviceList}"
                            Text="Connect"
                            TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!--  Scanning State - Collapsible Device List  -->
                <Border
                    Padding="15"
                    BackgroundColor="#E00A212C"
                    IsVisible="{Binding ShowDeviceList}"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <ActivityIndicator
                                HeightRequest="20"
                                IsRunning="{Binding IsScanning}"
                                IsVisible="{Binding IsScanning}"
                                VerticalOptions="Center"
                                WidthRequest="20"
                                Color="#F2F3EF" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="{Binding ScanHeaderText}"
                                VerticalOptions="Center" />

                            <HorizontalStackLayout
                                Grid.Column="2"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Button
                                    Padding="10,6"
                                    BackgroundColor="{StaticResource Gray500}"
                                    Command="{Binding StopScanCommand}"
                                    FontSize="12"
                                    IsVisible="{Binding IsScanning}"
                                    Text="Stop" />

                                <Button
                                    Padding="10,6"
                                    Command="{Binding ConnectToDeviceCommand}"
                                    FontSize="12"
                                    IsEnabled="{Binding CanConnectToSelected}"
                                    IsVisible="{Binding IsDeviceConnected, Converter={StaticResource InvertedBoolConverter}}"
                                    Text="Connect" />

                                <Button
                                    Padding="10,6"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AppDangerLight},
                                                                      Dark={StaticResource AppDangerDark}}"
                                    Command="{Binding DisconnectCommand}"
                                    FontSize="12"
                                    IsVisible="{Binding IsDeviceConnected}"
                                    Text="Disconnect" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!--  Device List  -->
                        <CollectionView
                            HeightRequest="200"
                            ItemSizingStrategy="MeasureFirstItem"
                            ItemsSource="{Binding DiscoveredDevices}"
                            SelectedItem="{Binding SelectedDevice}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceListItem">
                                    <Grid
                                        Margin="0,5"
                                        Padding="10"
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label FontAttributes="Bold" Text="{Binding Device.Name}" />
                                            <Border
                                                Padding="6,2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                                  Dark={StaticResource AppAccentDark}}"
                                                IsVisible="{Binding ShowBadge}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0">
                                                <Label
                                                    FontSize="10"
                                                    Text="{Binding BadgeText}"
                                                    TextColor="White" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{Binding Device.Rssi, StringFormat='{0} dBm'}"
                                            TextColor="{StaticResource White}" />

                                        <Label
                                            Grid.Row="1"
                                            FontSize="12"
                                            IsVisible="False"
                                            Text="{Binding Device.Address}"
                                            TextColor="{StaticResource White}" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#377A84" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!--  Compatibility Section  -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0">
                    <VerticalStackLayout Margin="5" Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Compatibility"
                            TextColor="#78E6D8" />
                        <Label
                            FontSize="12"
                            Text="This app supports all standard OBD2 adapters."
                            TextColor="#A2CCDA" />

                        <!--  Bluetooth Toggle  -->
                        <Border
                            Padding="20"
                            BackgroundColor="#E00A212C"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="15">
                                <Grid ColumnDefinitions="Auto,*,50" ColumnSpacing="15">
                                    <Label
                                        Padding="10,0,0,0"
                                        FontFamily="FontAwesomeBrands"
                                        FontSize="24"
                                        Text="&#xf293;"
                                        TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                    Dark={StaticResource AppAccentDark}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Bluetooth (BLE)"
                                        VerticalOptions="Center" />
                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding BluetoothEnabled}"
                                        OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                  Dark={StaticResource AppAccentDark}}" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource AppOutlineLight}, Dark={StaticResource AppOutlineDark}}" />

                                <!--  Wi-Fi Toggle  -->
                                <Grid ColumnDefinitions="Auto,*,50" ColumnSpacing="15">
                                    <Label
                                        FontFamily="FontAwesome"
                                        FontSize="24"
                                        Text="&#xf1eb;"
                                        TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                    Dark={StaticResource AppAccentDark}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="Wi-Fi"
                                        VerticalOptions="Center" />
                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding WiFiEnabled}"
                                        OnColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                                  Dark={StaticResource AppAccentDark}}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!--  Learn More Link  -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label
                        FontSize="12"
                        Text="Looking for a compatible adapter?"
                        TextColor="{AppThemeBinding Light={StaticResource AppAccentLight},
                                                    Dark={StaticResource AppAccentDark}}"
                        VerticalOptions="Center" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="Learn more"
                        TextColor="#78E6D8"
                        TextDecorations="Underline"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LearnMoreCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Error Display  -->
        <Border
            Grid.Row="2"
            Margin="15"
            Padding="10"
            BackgroundColor="{AppThemeBinding Light={StaticResource AppSurfaceRaisedLight},
                                              Dark={StaticResource AppSurfaceRaisedDark}}"
            IsVisible="{Binding HasError}"
            Stroke="{AppThemeBinding Light={StaticResource AppDangerLight},
                                     Dark={StaticResource AppDangerDark}}"
            StrokeShape="RoundRectangle 5"
            StrokeThickness="1">
            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}" />
        </Border>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ObdInsight.Pages.DiagnosticReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ble="clr-namespace:ObdInsight.Core.Transports.Ble;assembly=ObdInsight.Core"
    xmlns:vm="clr-namespace:ObdInsight.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:DiagnosticReportViewModel">

    <ContentPage.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="15" RowDefinitions="Auto,*,Auto">

        <!--  Header: Device & Progress  -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <!--  Device Selection  -->
            <Border
                Padding="15"
                BackgroundColor="#E00A212C"
                IsVisible="{Binding IsCollecting, Converter={StaticResource InvertedBoolConverter}}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Label Style="{StaticResource SectionLabel}" Text="Connected Device" />
                    <Button
                        Grid.Column="1"
                        Padding="10,5"
                        Command="{Binding SelectDeviceCommand}"
                        FontSize="12"
                        Text="Select" />

                    <Label
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="{Binding ConnectedDeviceName, TargetNullValue='No device connected'}" />
                    <Label
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource FieldLabel}"
                        Text="{Binding ConnectedDeviceAddress}" />
                </Grid>
            </Border>

            <!--  Progress Section (visible during collection)  -->
            <Border
                Padding="15"
                BackgroundColor="#E00A212C"
                IsVisible="{Binding IsCollecting}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="10">

                    <!--  Phase indicator  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding PhaseDescription}" />

                    <!--  Overall progress bar  -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <ProgressBar
                            HeightRequest="8"
                            Progress="{Binding OverallProgress}"
                            ProgressColor="{StaticResource Primary}" />
                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            FontSize="12"
                            Text="{Binding OverallProgress, StringFormat='{0:P0}'}" />
                        <Label
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="Overall Progress" />
                    </Grid>

                    <!--  Phase progress bar  -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <ProgressBar
                            HeightRequest="6"
                            Progress="{Binding PhaseProgress}"
                            ProgressColor="{StaticResource Secondary}" />
                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            FontSize="12"
                            Text="{Binding ItemsCompleted, StringFormat='{0}'}" />
                        <Label
                            Grid.Row="1"
                            LineBreakMode="TailTruncation"
                            Style="{StaticResource FieldLabel}"
                            Text="{Binding CurrentOperation}" />
                    </Grid>

                    <!--  Items counter  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label FontAttributes="Bold" Text="{Binding ItemsCompleted}" />
                        <Label Text="/" />
                        <Label Text="{Binding ItemsTotal}" />
                        <Label Style="{StaticResource FieldLabel}" Text="items" />
                    </HorizontalStackLayout>

                    <!--  Current item being probed  -->
                    <Border
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=#333333,
                                                          Dark=#333333}"
                        IsVisible="{Binding CurrentItem, Converter={StaticResource NullToBoolConverter}}"
                        Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 5">
                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource FieldLabel}" Text="Current:" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="Consolas"
                                    Text="{Binding CurrentItem}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource FieldLabel}" Text="Response:" />
                                <Label
                                    FontFamily="Consolas"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding LastResponse, TargetNullValue='...'}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Cancel button  -->
                    <Button
                        BackgroundColor="{StaticResource Gray500}"
                        Command="{Binding CancelCollectionCommand}"
                        HorizontalOptions="Center"
                        Text="Cancel" />
                </VerticalStackLayout>
            </Border>

            <!--  Completion message  -->
            <Border
                Padding="15"
                BackgroundColor="#E00A212C"
                IsVisible="{Binding IsComplete}"
                Stroke="{AppThemeBinding Light={StaticResource AppPositiveLight},
                                         Dark={StaticResource AppPositiveDark}}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="2">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="? Report Generated Successfully"
                        TextColor="{AppThemeBinding Light={StaticResource AppPositiveLight},
                                                    Dark={StaticResource AppPositiveDark}}" />
                    <Label
                        FontSize="12"
                        HorizontalOptions="Center"
                        LineBreakMode="MiddleTruncation"
                        Text="{Binding ReportFilePath}"
                        TextColor="{StaticResource Gray600}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Command="{Binding ShareReportCommand}" Text="Share Report" />
                        <Button
                            BackgroundColor="{StaticResource Secondary}"
                            Command="{Binding OpenReportCommand}"
                            Text="Open" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!--  Main Content: Vehicle Info Form or Log  -->
        <ScrollView Grid.Row="1" Margin="0,10">
            <VerticalStackLayout Spacing="10">

                <!--  Vehicle Info Form (hidden during collection)  -->
                <Border
                    Padding="15"
                    BackgroundColor="#E00A212C"
                    IsVisible="{Binding IsCollecting, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource SectionLabel}" Text="Vehicle Information" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource FieldLabel}" Text="Year" />
                                <Entry
                                    Keyboard="Numeric"
                                    Placeholder="2024"
                                    Text="{Binding VehicleYear}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource FieldLabel}" Text="Make" />
                                <Entry Placeholder="e.g., Nissan" Text="{Binding VehicleMake}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1">
                                <Label Style="{StaticResource FieldLabel}" Text="Model" />
                                <Entry Placeholder="e.g., Leaf" Text="{Binding VehicleModel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Style="{StaticResource FieldLabel}" Text="Trim (optional)" />
                                <Entry Placeholder="e.g., SL" Text="{Binding VehicleTrim}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout>
                            <Label Style="{StaticResource FieldLabel}" Text="Engine/Powertrain" />
                            <Picker ItemsSource="{Binding EngineTypes}" SelectedItem="{Binding EngineType}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Style="{StaticResource FieldLabel}" Text="Transmission" />
                            <Picker ItemsSource="{Binding TransmissionTypes}" SelectedItem="{Binding TransmissionType}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Style="{StaticResource FieldLabel}" Text="Additional Notes (optional)" />
                            <Editor
                                AutoSize="TextChanges"
                                HeightRequest="80"
                                Placeholder="Any relevant details about your vehicle..."
                                Text="{Binding AdditionalNotes}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--  Live Log (visible during/after collection)  -->
                <Border
                    Padding="10"
                    BackgroundColor="#E00A212C"
                    IsVisible="{Binding LogEntries.Count, Converter={StaticResource NullToBoolConverter}}"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <VerticalStackLayout Padding="20,0">
                        <Label Style="{StaticResource SectionLabel}" Text="Activity Log" />
                        <CollectionView
                            HeightRequest="300"
                            ItemsSource="{Binding LogEntries}"
                            SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticLogEntry">
                                    <Grid Padding="2" ColumnDefinitions="70,40,*">
                                        <Label
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Text="{Binding FormattedTime}"
                                            TextColor="{StaticResource Gray400}" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Text="{Binding Level}"
                                            TextColor="{Binding LevelColor}" />
                                        <Label
                                            Grid.Column="2"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Footer: Start Button  -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <!--  Error Display  -->
            <Border
                Padding="10"
                BackgroundColor="#4FD1C5"
                IsVisible="{Binding HasError}"
                Stroke="{AppThemeBinding Light={StaticResource AppDangerLight},
                                         Dark={StaticResource AppDangerDark}}"
                StrokeShape="RoundRectangle 5"
                StrokeThickness="1">
                <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource AppDangerLight}, Dark={StaticResource AppDangerDark}}" />
            </Border>

            <!--  Start Button  -->
            <Button
                Command="{Binding StartCollectionCommand}"
                FontAttributes="Bold"
                HeightRequest="50"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsCollecting, Converter={StaticResource InvertedBoolConverter}}"
                Text="Start Diagnostic Collection" />

            <!--  Instructions  -->
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsCollecting, Converter={StaticResource InvertedBoolConverter}}"
                Text="Make sure your vehicle is on (ignition on or running) before starting."
                TextColor="#78E6D8" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
